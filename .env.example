GEMINI_API_KEY=
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_NAME=Heike Ziegler
ADMIN_EMAIL=heike@make-success-your-habit.com
# Development only:
ADMIN_PASSWORD=change-me-heike
# Production recommended instead of ADMIN_PASSWORD:
ADMIN_PASSWORD_HASH=

# Persistent content storage. Choose one:
# Postgres, e.g. Vercel Postgres, Neon, Supabase
DATABASE_URL=
# Optional Vercel aliases also supported:
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=

# Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local SQLite fallback only:
CONTENT_DB_DIR=

# Vercel Blob for persistent uploads in production:
BLOB_READ_WRITE_TOKEN=
