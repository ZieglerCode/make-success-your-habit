  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port=3000",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port=3000",
    "preview": "cross-env NODE_OPTIONS=--no-deprecation next start --port=3000",
    "clean": "rm -rf dist server.js",
    "generate:isobl-images": "node scripts/generate-isobl-profile-images.mjs",
    "generate:ai-knowledge": "node scripts/generate-ai-knowledge.mjs",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "test:content": "tsx scripts/test-editor-insights.ts",
    "test:ai-knowledge": "tsx scripts/test-ai-knowledge.ts",
    "test:ai-core": "tsx scripts/test-ai-core.ts",
    "test:ai-usage": "tsx scripts/test-ai-usage.ts",
    "test:covers": "tsx scripts/test-cover-crop.ts",
    "test:cover-persistence": "tsx scripts/test-cover-persistence.ts",
    "test:isobl-images": "tsx scripts/test-isobl-profile-images.ts",
    "test:isobl-mapping": "tsx scripts/test-isobl-partner-images.ts",
    "test:partner-story-profile": "tsx scripts/test-partner-story-profile.ts",
    "test:uploads": "tsx scripts/test-upload-serving.ts",
    "hash:admin-password": "node scripts/hash-admin-password.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
