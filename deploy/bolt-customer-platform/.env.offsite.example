# Restic encrypts every backup before it leaves the VPS.
#
# S3 / Backblaze B2 example:
RESTIC_REPOSITORY=s3:s3.eu-central-003.backblazeb2.com/your-private-bucket/bolt
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
#
# Hetzner Storage Box SFTP alternative:
# RESTIC_REPOSITORY=sftp:username@username.your-storagebox.de:/backups/bolt

# Store the actual password in this root-only file, not in this env file.
RESTIC_PASSWORD_FILE=/data/bolt-customer-platform/restic-password
RESTIC_INIT_REPOSITORY=true

# Optional, useful for self-hosted S3-compatible storage:
# AWS_DEFAULT_REGION=eu-central-1
